[Nemo Action]
# Right-click an image → set it as the wallpaper through Waypaper, so it is
# applied by awww, saved in waypaper/config.ini and the lock screen follows
# (~/Pictures/Wallpapers/.current, Waypaper's post_command).
Name=Definir como wallpaper
Comment=Usar esta imagem como papel de parede
Exec="@HOME@/.local/bin/set-wallpaper" %F
Icon-Name=preferences-desktop-wallpaper
Selection=s
Mimetypes=image/png;image/jpeg;image/webp;image/jxl;image/gif;image/bmp;image/avif;
