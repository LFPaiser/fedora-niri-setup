<?xml version="1.0" encoding="UTF-8"?>
<!-- Umbra for GtkSourceView 5 (GNOME Text Editor): the Ghostty colours.
     Purple base, cream text, amber cursor/accents, surface1 selection. -->
<style-scheme id="umbra" name="Umbra" version="1.0">
  <author>fedora-niri-setup</author>
  <description>Roxo escuro, texto creme, destaques em âmbar</description>
  <metadata>
    <property name="variant">dark</property>
  </metadata>

  <color name="crust"    value="#14031a"/>
  <color name="mantle"   value="#1c0624"/>
  <color name="base"     value="#26082f"/>
  <color name="surface0" value="#3a1544"/>
  <color name="surface1" value="#57235a"/>
  <color name="overlay0" value="#7d5a80"/>
  <color name="overlay1" value="#8f6a90"/>
  <color name="haze"     value="#bfa6c2"/>
  <color name="subtext"  value="#d9c4b8"/>
  <color name="text"     value="#fdf0dc"/>
  <color name="amber"    value="#e0a050"/>
  <color name="lilac"    value="#c58bd6"/>
  <color name="violet"   value="#b48ee0"/>
  <color name="pink"     value="#f0a6c8"/>
  <color name="peach"    value="#e89a5c"/>
  <color name="yellow"   value="#f2cf8a"/>
  <color name="green"    value="#a8c98a"/>
  <color name="teal"     value="#8fcfc0"/>
  <color name="red"      value="#e86a7a"/>
  <color name="urgent"   value="#e5455a"/>

  <!-- Editor surface -->
  <style name="text"                        foreground="text" background="base"/>
  <style name="selection"                   foreground="text" background="surface1"/>
  <style name="selection-unfocused"         background="surface0"/>
  <style name="cursor"                      foreground="amber"/>
  <style name="secondary-cursor"            foreground="overlay1"/>
  <style name="current-line"                background="mantle"/>
  <style name="line-numbers"                foreground="overlay0" background="base"/>
  <style name="current-line-number"         foreground="amber" background="mantle" bold="true"/>
  <style name="right-margin"                foreground="surface0" background="mantle"/>
  <style name="draw-spaces"                 foreground="surface1"/>
  <style name="background-pattern"          background="mantle"/>
  <style name="bracket-match"               foreground="amber" background="surface0" bold="true"/>
  <style name="bracket-mismatch"            foreground="text" background="urgent"/>
  <style name="search-match"                foreground="crust" background="yellow"/>
  <style name="map-overlay"                 background="surface0"/>
  <style name="snippet-focus"               background="surface0"/>

  <!-- Code -->
  <style name="def:comment"                 foreground="overlay1" italic="true"/>
  <style name="def:shebang"                 foreground="overlay1" bold="true"/>
  <style name="def:doc-comment-element"     foreground="haze" italic="true"/>
  <style name="def:keyword"                 foreground="lilac" bold="true"/>
  <style name="def:statement"               foreground="lilac"/>
  <style name="def:type"                    foreground="amber"/>
  <style name="def:builtin"                 foreground="peach"/>
  <style name="def:function"                foreground="teal"/>
  <style name="def:identifier"              foreground="subtext"/>
  <style name="def:preprocessor"            foreground="pink"/>
  <style name="def:constant"                foreground="peach"/>
  <style name="def:special-constant"        foreground="peach"/>
  <style name="def:boolean"                 foreground="peach"/>
  <style name="def:number"                  foreground="peach"/>
  <style name="def:string"                  foreground="green"/>
  <style name="def:special-char"            foreground="yellow"/>
  <style name="def:character"               foreground="green"/>
  <style name="def:operator"                foreground="haze"/>
  <style name="def:net-address"             foreground="teal" underline="single"/>
  <style name="def:emphasis"                italic="true"/>
  <style name="def:strong-emphasis"         bold="true"/>
  <style name="def:heading"                 foreground="amber" bold="true"/>
  <style name="def:link-text"               foreground="violet"/>
  <style name="def:link-destination"        foreground="teal" underline="single"/>
  <style name="def:inline-code"             foreground="green"/>
  <style name="def:list-marker"             foreground="amber" bold="true"/>
  <style name="def:insertion"               foreground="green"/>
  <style name="def:deletion"                foreground="red"/>
  <style name="def:error"                   underline="error" underline-color="urgent"/>
  <style name="def:warning"                 underline="error" underline-color="yellow"/>
  <style name="def:note"                    foreground="crust" background="amber" bold="true"/>
  <style name="def:underlined"              underline="single"/>

  <!-- Diff -->
  <style name="diff:added-line"             foreground="green"/>
  <style name="diff:removed-line"           foreground="red"/>
  <style name="diff:changed-line"           foreground="yellow"/>
  <style name="diff:location"               foreground="lilac" bold="true"/>
  <style name="diff:diff-file"              foreground="amber" bold="true"/>
  <style name="diff:special-case"           foreground="haze"/>
</style-scheme>
