#!/usr/bin/env bash
# Volume / brightness keys with an on-screen bar (wob).
#   osd daemon                       start wob (niri autostart)
#   osd volume-up|volume-down|mute
#   osd brightness-up|brightness-down
#   osd group media|notifications|system|calls up|down|mute
#        a volume group (pipewire/pipewire.conf.d/60-volume-groups.conf)
fifo="${XDG_RUNTIME_DIR:-/tmp}/wob.sock"

show() { [ -p "$fifo" ] && echo "$1" > "$fifo"; }

volume() {
    wpctl get-volume "${1:-@DEFAULT_AUDIO_SINK@}" |
        awk '{ v = int($2 * 100); if ($3 == "[MUTED]") v = 0; print v }'
}

case "$1" in
    daemon)
        rm -f "$fifo" && mkfifo "$fifo"
        tail -f "$fifo" | wob
        ;;
    volume-up)       wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+; show "$(volume)" ;;
    volume-down)     wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-; show "$(volume)" ;;
    mute)            wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle; show "$(volume)" ;;
    group)
        id=$(pw-cli info "group.$2" 2>/dev/null | awk '/^[[:space:]]*id:/ { print $2; exit }')
        [ -n "$id" ] || { echo "no volume group '$2'" >&2; exit 1; }
        case "$3" in
            up)   wpctl set-volume -l 1.0 "$id" 5%+ ;;
            down) wpctl set-volume "$id" 5%- ;;
            mute) wpctl set-mute "$id" toggle ;;
            *) echo "usage: osd group NAME up|down|mute" >&2; exit 1 ;;
        esac
        show "$(volume "$id")"
        ;;
    brightness-up)   show "$(brightnessctl -m set 5%+ | cut -d, -f4 | tr -d %)" ;;
    brightness-down) show "$(brightnessctl -m set 5%- | cut -d, -f4 | tr -d %)" ;;
    *) echo "usage: osd daemon|volume-up|volume-down|mute|brightness-up|brightness-down|group NAME up|down|mute" >&2; exit 1 ;;
esac
