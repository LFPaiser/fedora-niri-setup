#!/bin/bash
# Emoji picker (Super+Ctrl+Space). Search by English or Portuguese name ("coração", "risada").
# Copies the emoji to the clipboard and, when wtype is installed, types it into the focused window.
# List: ~/.local/share/emoji/emoji.txt (regenerate with scripts/gen-emoji.py).
list=~/.local/share/emoji/emoji.txt
[ -r "$list" ] || { notify-send "Emoji" "List not found: $list"; exit 1; }

choice=$(fuzzel --dmenu --prompt '󰞅  ' --width 60 --lines 12 --cache "${XDG_CACHE_HOME:-$HOME/.cache}/fuzzel-emoji" < "$list") || exit 0
emoji=${choice%% *}
[ -n "$emoji" ] || exit 0

printf %s "$emoji" | wl-copy
if command -v wtype >/dev/null; then
    sleep 0.15  # let focus return to the previous window
    wtype -- "$emoji"
fi
