<dict><key>settings</key><dict><key>background</key><string>#26082f</string><key>foreground</key><string>#fdf0dc</string><key>caret</key><string>#e0a050</string><key>lineHighlight</key><string>#3a1544</string><key>selection</key><string>#57235a</string><key>gutter</key><string>#26082f</string><key>gutterForeground</key><string>#8f6a90</string></dict></dict>
