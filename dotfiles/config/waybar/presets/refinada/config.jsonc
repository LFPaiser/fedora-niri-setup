// Refinada: separate floating pills. CPU/RAM/disk hide in a drawer (hover the CPU to open).
{
    "include": ["~/.config/waybar/modules.jsonc"],
    "layer": "top", "position": "top", "height": 32, "spacing": 6,
    "margin-top": 6, "margin-left": 6, "margin-right": 6,

    "modules-left":   ["custom/launcher", "niri/workspaces", "niri/window"],
    "modules-center": ["group/time"],
    "group/time": { "orientation": "horizontal", "modules": ["clock", "custom/weather"] },
    "modules-right":  ["mpris", "privacy", "group/hw", "group/info", "group/conn", "group/media", "custom/power"],

    "group/hw": {
        "orientation": "horizontal",
        "drawer": { "transition-duration": 250, "transition-left-to-right": false },
        "modules": ["cpu", "memory", "disk", "temperature", "custom/uptime"]
    }
}
