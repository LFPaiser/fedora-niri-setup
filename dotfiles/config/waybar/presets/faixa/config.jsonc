// Faixa: thin floating band with rounded corners, modules in groups, app icon next to the title.
{
    "include": ["~/.config/waybar/modules.jsonc"],
    "layer": "top", "position": "top", "height": 28, "spacing": 0,
    "margin-top": 6, "margin-left": 6, "margin-right": 6,

    "modules-left":   ["niri/workspaces", "niri/window"],
    "modules-center": ["clock", "custom/weather"],
    "modules-right":  ["mpris", "privacy", "group/hw", "group/info", "group/conn", "group/media", "group/power"],

    // Shows the name of the "sistema" workspace, and the others with the number of their
    // shortcut: "sistema" is niri's workspace 1 (Super+0), so niri's 2 is Super+1, and so on.
    "niri/workspaces": { "format": "{icon}",
        "format-icons": { "sistema": "sistema", "2": "1", "3": "2", "4": "3", "5": "4", "6": "5", "7": "6", "8": "7", "9": "8", "10": "9" } },
    "niri/window": { "max-length": 60, "icon": true, "icon-size": 14 },
    "tray": { "icon-size": 13, "spacing": 8 }
}
