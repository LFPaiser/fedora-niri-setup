// Waybar entry point: loads one preset from ~/.config/waybar/presets.
//   Try one for this session:   ~/.config/waybar/scripts/try refinada
//   Make it the default:        ~/.config/waybar/scripts/try refinada --fixar
// (presets: faixa, solida, refinada, minimal — shared modules in modules.jsonc)
{ "include": ["~/.config/waybar/presets/faixa/config.jsonc"] }
