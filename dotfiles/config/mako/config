# Notifications. Umbra (from wallpaper).
font=Inter 11
background-color=#26082ff0
text-color=#fdf0dc
border-color=#e0a050
progress-color=over #57235a
border-size=2
border-radius=12
padding=12
margin=6
width=360
icons=1
max-icon-size=48
default-timeout=5000
anchor=top-right

[urgency=high]
border-color=#e5455a
default-timeout=0

[mode=do-not-disturb]
invisible=1
