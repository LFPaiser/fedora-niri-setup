# Notifications. Umbra (from wallpaper).
font=Inter 11
background-color=#26082ff0
text-color=#fdf0dc
border-color=#e0a050
progress-color=over #57235a
border-size=2
border-radius=12
padding=12
margin=6
width=360
icons=1
max-icon-size=48
default-timeout=8000
anchor=top-right
# History kept for Super+Ctrl+N (makoctl restore); default is only 5.
max-history=50
sort=-time
# Up to 4 cards on screen; the rest wait in line ("+N" card).
max-visible=4
# Same app → one stacked card with a counter. Urgency in the key keeps an urgent
# notification out of a group of normal ones.
group-by=app-name,urgency
# Sound on each new notification, through the Notifications volume group
# (media-role Notification → group.notifications; see pipewire.conf.d/60-volume-groups.conf).
on-notify=exec pw-play --media-role=Notification /usr/share/sounds/freedesktop/stereo/message.oga

[grouped]
format=<b>%s</b>  <small>(%g)</small>\n%b

[urgency=low]
on-notify=none

[urgency=high]
border-color=#e5455a
default-timeout=0
on-notify=exec pw-play --media-role=Notification /usr/share/sounds/freedesktop/stereo/dialog-warning.oga

# Do not disturb (bell in the bar): hidden and silent
[mode=do-not-disturb]
invisible=1
on-notify=none
