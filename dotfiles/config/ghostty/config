# Ghostty — https://ghostty.org/docs/config/reference
# Reload with Ctrl+Shift+, inside Ghostty.
theme = Catppuccin Mocha
font-family = JetBrainsMono Nerd Font
font-size = 11

window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
window-decoration = none
background-opacity = 0.94

cursor-style = bar
cursor-style-blink = true
mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = false
shell-integration-features = no-cursor,sudo,title

# Splits/tabs, kept away from niri's Super bindings
keybind = ctrl+shift+enter=new_split:auto
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+j=goto_split:down
