# Ghostty — https://ghostty.org/docs/config/reference
# Reload with Ctrl+Shift+, inside Ghostty.
theme = Umbra
font-family = JetBrainsMono Nerd Font
font-size = 11
adjust-cell-height = 8%

window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
window-decoration = none
background-opacity = 0.94
unfocused-split-opacity = 0.6

cursor-style = bar
cursor-style-blink = true
mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = false
# All windows share one process (the default, gtk-single-instance = detect): new windows
# open instantly and memory stays low. Trade-off, chosen knowingly: if Ghostty crashes,
# every window closes with it. One process per window would be: gtk-single-instance = false
scrollback-limit-bytes = 100000000

# ssh-env/ssh-terminfo: remote hosts learn xterm-ghostty instead of erroring out
shell-integration-features = no-cursor,sudo,title,ssh-env,ssh-terminfo

# No toast on every copy-on-select
app-notifications = no-clipboard-copy

# Desktop notification when a long command finishes in an unfocused window
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify,no-bell
notify-on-command-finish-after = 10s

# Splits, kept away from niri's Super bindings
keybind = ctrl+shift+enter=new_split:auto
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+z=toggle_split_zoom
keybind = ctrl+shift+equal=equalize_splits
keybind = ctrl+shift+alt+h=resize_split:left,20
keybind = ctrl+shift+alt+l=resize_split:right,20
keybind = ctrl+shift+alt+k=resize_split:up,20
keybind = ctrl+shift+alt+j=resize_split:down,20
